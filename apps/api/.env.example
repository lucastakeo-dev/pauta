# Banco de desenvolvimento (docker compose up -d db) — porta 5441 para não colidir
# com os outros Postgres da máquina (5432, 5433, 5439, 55432).
DATABASE_URL="postgresql://pauta:pauta@127.0.0.1:5441/pauta?schema=public"
DIRECT_DATABASE_URL="postgresql://pauta:pauta@127.0.0.1:5441/pauta?schema=public"

# Em produção (Supabase): DATABASE_URL usa o pooler (6543) e DIRECT_DATABASE_URL a
# conexão direta (5432), que é a que o `prisma migrate` precisa.

# 32+ caracteres. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-real-de-no-minimo-32-caracteres"
JWT_EXPIRES_IN="30d"

PORT=3334
HOST="0.0.0.0"
NODE_ENV="development"

# A chave do Agent. Opcional: sem ela o app funciona inteiro e só o Agent responde
# 503 dizendo o que falta. Pegue em console.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-..."

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGINS="http://localhost:5176"
