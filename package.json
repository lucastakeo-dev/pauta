{
  "name": "pauta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @pauta/api dev",
    "dev:web": "pnpm --filter @pauta/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "pnpm --filter @pauta/api db:migrate",
    "db:studio": "pnpm --filter @pauta/api db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "~6.0.3"
  }
}
