{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/routeTree.gen.ts",
      "!**/prisma/migrations",
      "!**/src/generated",
      "!**/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@prisma/client", "**/config/prisma*"],
                    "message": "MVC: só models/ acessa o Prisma. Controller e view falam com o model."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/models/**", "apps/api/src/config/**"],
      "linter": {
        "rules": {
          "style": { "noRestrictedImports": "off" }
        }
      }
    },
    {
      "includes": ["apps/api/src/models/**", "apps/api/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "fastify",
                      "fastify/**",
                      "**/controllers/**",
                      "**/routes/**",
                      "**/views/**"
                    ],
                    "message": "MVC: o model não conhece HTTP. Regra de negócio não importa Fastify nem controller."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/entities/**", "@/features/**", "@/pages/**", "@/app/**"],
                    "message": "Camadas: shared é a base, não importa de cima. Só desce, nunca sobe."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/pages/**", "@/app/**"],
                    "message": "Camadas: entities só pode importar de shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/pages/**", "@/app/**"],
                    "message": "Camadas: features não conhece as páginas que a usam."
                  },
                  {
                    "group": ["@/features/**"],
                    "message": "Camadas: features não conversam entre si. Dentro da própria feature use caminho relativo ('./'); o que for comum a duas desce para entities ou shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Camadas: a página não conhece o bootstrap da aplicação."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
